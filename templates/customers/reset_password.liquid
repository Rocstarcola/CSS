<section class="account-wrap">
  <div class="container">
    <div class="auth-card">
      <h1>{{ 'customer.recover_password.title' | t }}</h1>
      {%- form 'reset_customer_password', class: 'field-stack' -%}
        {%- if form.errors -%}<div class="form-status form-status--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="form-field">{{ 'customer.login.password' | t }}
          <input type="password" name="customer[password]" required>
        </label>
        <label class="form-field">Confirm password
          <input type="password" name="customer[password_confirmation]" required>
        </label>
        <button type="submit" class="btn btn-primary full">{{ 'customer.recover_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
