<section class="account-wrap">
  <div class="container narrow">
    <div class="page-header" style="display:flex; justify-content:space-between; align-items:center; text-align:left;">
      <h1>{{ 'customer.account.title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="btn btn-outline btn-small">Log out</a>
    </div>

    <p>Hi {{ customer.first_name | default: customer.email }}! 👋</p>
    <p><a href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }}</a> ({{ customer.addresses_count }})</p>

    <h2 style="margin-top:2rem;">{{ 'customer.account.order_history' | t }}</h2>
    {%- if customer.orders.size > 0 -%}
      <table class="account-table">
        <thead>
          <tr>
            <th>{{ 'customer.orders.order_number' | t }}</th>
            <th>{{ 'customer.orders.date' | t }}</th>
            <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
            <th>{{ 'customer.orders.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_net_amount | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p style="color:var(--ink-soft);">{{ 'customer.account.no_orders' | t }}</p>
    {%- endif -%}
  </div>
</section>
