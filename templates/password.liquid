<div class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-inner" style="grid-template-columns:1fr; text-align:center; min-height:60vh; place-items:center;">
    <div class="hero-copy" style="max-width:560px;">
      <div class="brand-mark" style="font-size:3rem;">🧰</div>
      <h1 style="margin-top:1rem;">{{ shop.name }}</h1>
      <p class="lead" style="margin-inline:auto;">{{ shop.password_message | default: 'Treasure is being loaded. We open soon!' }}</p>

      {%- form 'storefront_password', class: 'contact-form', style: 'max-width:420px; margin:1.5rem auto 0;' -%}
        {%- if form.errors -%}
          <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label>Enter password
          <input type="password" name="password" placeholder="Password">
        </label>
        <button type="submit" class="btn btn-primary full">Enter</button>
      {%- endform -%}
    </div>
  </div>
</div>
