{%- comment -%}
  Renders a product card.
  Accepts: product (object), quick_add (boolean, optional)
{%- endcomment -%}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  end
  assign show_quick_add = quick_add | default: settings.card_quick_add
-%}
<div class="product-card">
  <a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 600 | image_tag: widths: '300, 450, 600', loading: 'lazy', alt: product.featured_media.alt | default: product.title }}
    {%- else -%}
      <span class="product-card__placeholder">⚙️</span>
    {%- endif -%}
    {%- if on_sale -%}<span class="product-card__badge">Sale</span>{%- elsif product.available == false -%}<span class="product-card__badge">Sold out</span>{%- endif -%}
  </a>
  <div class="product-card__body">
    {%- if settings.show_vendor and product.vendor != blank -%}
      <span class="product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if product.selling_plan_groups.size > 0 -%}
      <span class="product-card__sub-badge">🔁 Subscription available</span>
    {%- endif -%}
    <div class="product-card__price">
      {%- if on_sale -%}
        <span class="now">{{ product.price | money }}</span>
        <span class="was">{{ product.compare_at_price | money }}</span>
      {%- else -%}
        {%- if product.price_varies -%}<span>From </span>{%- endif -%}
        <span>{{ product.price | money }}</span>
      {%- endif -%}
    </div>
    {%- if show_quick_add and product.available -%}
      {%- if product.variants.size == 1 -%}
        {%- form 'product', product, data-ajax-cart: '', class: 'product-card__form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="btn btn-small full">Add to cart</button>
        {%- endform -%}
      {%- else -%}
        <a href="{{ product.url }}" class="btn btn-small full">Choose options</a>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
