<section id="business" class="section section-alt">
  <div class="container business-grid">
    <div class="business-copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <ul class="benefits">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <li {{ block.shopify_attributes }}>
              <span>{{ block.settings.icon }}</span>
              <div><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <div class="business-who">
      <h3>{{ section.settings.who_title }}</h3>
      <ul class="who-list">
        {%- assign items = section.settings.who_list | newline_to_br | split: '<br />' -%}
        {%- for item in items -%}
          {%- assign t = item | strip -%}
          {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "For business",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Gadgetron" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Small-batch 3D prints you'll actually love" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every gadget is printed to order in-house — no warehouses of mass-produced plastic. Pick a color, request a custom design, or let the Surprise Box of the Month keep things fun." },
    { "type": "text", "id": "who_title", "label": "Category list title", "default": "Shop by category" },
    { "type": "textarea", "id": "who_list", "label": "Category items (one per line)", "default": "🧰 Treasure boxes\n🎲 Desk toys & fidgets\n🔧 Gadgets & tools\n🏠 Home & organization\n🎁 Gifts\n🎨 Custom prints" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "👨‍👩‍👧" },
        { "type": "text", "id": "title", "label": "Title", "default": "Bring families back" },
        { "type": "text", "id": "text", "label": "Text", "default": "Kids remember the prize box and beg to return." }
      ]
    }
  ],
  "presets": [
    {
      "name": "For business",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "🛠️", "title": "Made to order", "text": "Printed fresh when you order, in the color you pick." } },
        { "type": "benefit", "settings": { "icon": "🎁", "title": "Surprise Box", "text": "A mystery gadget worth more than you pay, every month." } },
        { "type": "benefit", "settings": { "icon": "🎨", "title": "Custom designs", "text": "Have an idea? We can design and print it for you." } },
        { "type": "benefit", "settings": { "icon": "🌎", "title": "Low-waste", "text": "Printed in-house with durable, plant-based PLA." } }
      ]
    }
  ]
}
{% endschema %}
