<section class="section">
  <div class="container">
    <div class="product" data-gallery>
      <div class="product-gallery">
        <div class="product-gallery__main" data-gallery-main>
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 900 | image_tag: widths: '450, 700, 900', loading: 'eager', alt: product.featured_media.alt | default: product.title }}
          {%- else -%}
            <div class="product-gallery__placeholder">⚙️</div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for media in product.media -%}
              <button type="button" data-gallery-thumb data-src="{{ media | image_url: width: 900 }}" class="{% if forloop.first %}active{% endif %}" aria-label="View image {{ forloop.index }}">
                {{ media | image_url: width: 150 | image_tag: widths: '150', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-info">
        {%- if settings.show_vendor and product.vendor != blank -%}<p class="product-vendor">{{ product.vendor }}</p>{%- endif -%}
        <h1>{{ product.title }}</h1>

        <div class="product-price" data-product-price>
          {%- if product.compare_at_price > product.price -%}
            <span class="now">{{ product.price | money }}</span>
            <span class="was">{{ product.compare_at_price | money }}</span>
          {%- else -%}
            {{ product.price | money }}
          {%- endif -%}
        </div>

        {%- form 'product', product, id: 'product-form', class: 'product-form', data-product-form: '', data-ajax-cart: '' -%}
          <script type="application/json" data-variants>
            [
              {%- for v in product.variants -%}
                {
                  "id": {{ v.id }},
                  "options": {{ v.options | json }},
                  "available": {{ v.available }},
                  "price": {{ v.price | money | json }},
                  "compare_at_price": {{ v.compare_at_price | money | json }},
                  "on_sale": {% if v.compare_at_price > v.price %}true{% else %}false{% endif %},
                  "selling_plan_allocations": {
                    {%- for a in v.selling_plan_allocations -%}
                      "{{ a.selling_plan.id }}": {{ a.price | money | json }}{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  }
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          </script>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="variant-option">
                <span>{{ option.name }}</span>
                <div class="variant-values">
                  {%- for value in option.values -%}
                    <label>
                      <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" data-option-index{% if option.selected_value == value %} checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- if product.selling_plan_groups.size > 0 -%}
            {%- assign sel_variant = product.selected_or_first_available_variant -%}
            <fieldset class="selling-plans" data-selling-plans>
              <legend class="selling-plans__legend">{{ 'products.product.purchase_options' | t }}</legend>

              {%- unless product.requires_selling_plan -%}
                <label class="selling-plan-option">
                  <input type="radio" name="selling_plan" value="" data-selling-plan-radio checked>
                  <span class="selling-plan-option__text">
                    <strong>{{ 'products.product.one_time' | t }}</strong>
                    <span class="selling-plan-option__price" data-base-price>{{ sel_variant.price | money }}</span>
                  </span>
                </label>
              {%- endunless -%}

              {%- for group in product.selling_plan_groups -%}
                {%- if group.name != blank -%}<p class="selling-plans__group-name">{{ group.name }}</p>{%- endif -%}
                {%- for plan in group.selling_plans -%}
                  {%- assign allocation = nil -%}
                  {%- for a in sel_variant.selling_plan_allocations -%}
                    {%- if a.selling_plan.id == plan.id -%}{%- assign allocation = a -%}{%- endif -%}
                  {%- endfor -%}
                  <label class="selling-plan-option">
                    <input type="radio" name="selling_plan" value="{{ plan.id }}" data-selling-plan-radio {% if product.requires_selling_plan and forloop.first %}checked{% endif %}>
                    <span class="selling-plan-option__text">
                      <strong>🔁 {{ plan.name }}</strong>
                      <span class="selling-plan-option__price" data-plan-price="{{ plan.id }}">
                        {%- if allocation -%}
                          {{ allocation.price | money }}
                          {%- if allocation.compare_at_price > allocation.price -%}
                            <span class="selling-plan-option__save">save {{ allocation.compare_at_price | minus: allocation.price | money }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </span>
                    </span>
                  </label>
                {%- endfor -%}
              {%- endfor -%}
            </fieldset>
          {%- endif -%}

          <div class="qty-row">
            <div class="qty-stepper">
              <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}">
              <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary big full" data-add-btn data-label="{{ 'products.product.add_to_cart' | t }}" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            {%- if product.selected_or_first_available_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </button>
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="rte product-description" style="margin-top:1.6rem;">{{ product.description }}</div>
        {%- endif -%}

        <div class="product-meta">
          {{ 'products.product.shipping_policy' | t }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product information",
  "settings": [],
  "blocks": [],
  "presets": [{ "name": "Product information" }]
}
{% endschema %}
