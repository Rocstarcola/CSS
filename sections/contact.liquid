<section id="contact" class="section section-cta">
  <div class="container narrow">
    <div class="section-head">
      <p class="eyebrow center light">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-sub light">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    {%- form 'contact', id: 'quoteForm', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="form-status form-status--success">Thanks! Your request is in — we'll be in touch soon. 🎉</div>
      {%- elsif form.errors -%}
        <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="form-row">
        <label>Your name
          <input type="text" name="contact[name]" required placeholder="Alex Smith" value="{{ form.name }}">
        </label>
        <label>Email
          <input type="email" name="contact[email]" required placeholder="you@email.com" value="{{ form.email }}">
        </label>
      </div>
      <label>What's this about?
        <select name="contact[Topic]">
          <option>General question</option>
          <option>Custom design request</option>
          <option>Surprise Box question</option>
          <option>Help with an order</option>
        </select>
      </label>
      <label>Tell us more
        <textarea name="contact[body]" rows="4" placeholder="Describe your question or the custom gadget you have in mind…">{{ form.body }}</textarea>
      </label>
      <button type="submit" class="btn btn-primary full big">{{ section.settings.button_label }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact / quote form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Say hi" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions or a custom idea?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Want a custom gadget printed, or have a question about the Surprise Box? Drop us a line." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" }
  ],
  "presets": [{ "name": "Contact / quote form" }]
}
{% endschema %}
