<section id="contact" class="section section-cta">
  <div class="container narrow">
    <div class="section-head">
      <p class="eyebrow center light">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-sub light">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    {%- form 'contact', id: 'quoteForm', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="form-status form-status--success">Thanks! Your request is in — we'll be in touch soon. 🎉</div>
      {%- elsif form.errors -%}
        <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="form-row">
        <label>Your name
          <input type="text" name="contact[name]" required placeholder="Jane Smith" value="{{ form.name }}">
        </label>
        <label>Business name
          <input type="text" name="contact[Business]" placeholder="Jane's Diner">
        </label>
      </div>
      <div class="form-row">
        <label>Email
          <input type="email" name="contact[email]" required placeholder="you@business.com" value="{{ form.email }}">
        </label>
        <label>Phone <span class="opt">(optional)</span>
          <input type="tel" name="contact[phone]" placeholder="(555) 123-4567">
        </label>
      </div>
      <div class="form-row">
        <label>Which box interests you?
          <select name="contact[Box interest]">
            <option value="Not sure yet">Not sure yet</option>
            <option>The Classic Chest</option>
            <option>The Castle Vault</option>
            <option>The Mini Stash</option>
            <option>Custom design</option>
          </select>
        </label>
        <label>Refill plan?
          <select name="contact[Refill plan]">
            <option value="Just the box for now">Just the box for now</option>
            <option>Monthly refills</option>
            <option>Quarterly refills</option>
            <option>Multi-shop / bulk</option>
          </select>
        </label>
      </div>
      <label>Tell us more <span class="opt">(optional)</span>
        <textarea name="contact[body]" rows="4" placeholder="Type of business, typical kid ages, how many locations…">{{ form.body }}</textarea>
      </label>
      <button type="submit" class="btn btn-primary full big">{{ section.settings.button_label }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact / quote form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get Started" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's fill your counter with treasure" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tell us about your business and we'll send a free, no-pressure quote." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send my quote request" }
  ],
  "presets": [{ "name": "Contact / quote form" }]
}
{% endschema %}
