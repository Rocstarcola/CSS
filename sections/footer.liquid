<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col footer-brand">
      <span class="brand-mark">🧰</span>
      <span class="brand-text">{{ shop.name }}</span>
      <p class="footer-tag">{{ section.settings.tagline }}</p>
      <div class="footer-social">
        {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" aria-label="Instagram">📸</a>{%- endif -%}
        {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" aria-label="Facebook">👍</a>{%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">🎵</a>{%- endif -%}
      </div>
    </div>

    {%- if section.settings.menu_1 != blank -%}
      <div class="footer-col">
        <h4>{{ section.settings.menu_1_title }}</h4>
        <ul>
          {%- for link in section.settings.menu_1.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.menu_2 != blank -%}
      <div class="footer-col">
        <h4>{{ section.settings.menu_2_title }}</h4>
        <ul>
          {%- for link in section.settings.menu_2.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div class="footer-col footer-newsletter">
        <h4>{{ section.settings.newsletter_title }}</h4>
        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display:flex; gap:.5rem; margin-top:.4rem;">
            <input type="email" name="contact[email]" placeholder="you@email.com" required aria-label="Email">
            <button type="submit" class="btn btn-small">Join</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p style="color: var(--gold); margin:.5rem 0 0;">Thanks for subscribing! 🎉</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>

  <div class="container footer-bottom">
    <p>&copy; <span id="year">{{ 'now' | date: '%Y' }}</span> {{ shop.name }}. {{ section.settings.copyright }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "3D-printed treasure boxes & prize refills for businesses." },
    { "type": "header", "content": "Menu column 1" },
    { "type": "text", "id": "menu_1_title", "label": "Title", "default": "Shop" },
    { "type": "link_list", "id": "menu_1", "label": "Menu" },
    { "type": "header", "content": "Menu column 2" },
    { "type": "text", "id": "menu_2_title", "label": "Title", "default": "Company" },
    { "type": "link_list", "id": "menu_2", "label": "Menu" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter title", "default": "Get prize drops & deals" },
    { "type": "header", "content": "Bottom" },
    { "type": "text", "id": "copyright", "label": "Copyright note", "default": "Made with 💛 and a 3D printer." }
  ]
}
{% endschema %}
