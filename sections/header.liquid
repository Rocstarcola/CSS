<script>
  window.themeMoneyFormat = {{ shop.money_format | json }};
</script>

<header class="site-header" id="top">
  <nav class="nav container" aria-label="Primary">
    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }} home">
      {%- assign brand_logo = section.settings.logo | default: settings.logo -%}
      {%- if brand_logo != blank -%}
        {%- capture logo_style -%}max-width:{{ settings.logo_width }}px;{%- endcapture -%}
        {{ brand_logo | image_url: width: 600 | image_tag: widths: '200, 300, 450, 600', class: 'brand-logo', style: logo_style, alt: shop.name }}
      {%- else -%}
        <img class="brand-mark" src="{{ 'logo-icon.svg' | asset_url }}" alt="" width="44" height="44" loading="eager">
        {%- if shop.name == 'Gadgetron' -%}
          <span class="brand-text">Gadget<span class="brand-accent">ron</span></span>
        {%- else -%}
          <span class="brand-text">{{ shop.name }}</span>
        {%- endif -%}
      {%- endif -%}
    </a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <ul class="nav-links">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>

    <div class="nav-actions">
      <a href="{{ routes.search_url }}" class="nav-icon" aria-label="Search">🔍</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="nav-icon" aria-label="Account">👤</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="nav-icon" data-cart-link aria-label="Cart">
        🛒 <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (overrides theme logo)"
    }
  ]
}
{% endschema %}
