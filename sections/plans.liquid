<section id="plans" class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow center">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="plans">
      {%- for block in section.blocks -%}
        <article class="plan {% if block.settings.featured %}plan-best{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<div class="badge">{{ block.settings.badge }}</div>{%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p class="plan-tag">{{ block.settings.tag }}</p>
          <p class="price"><span class="amt">{{ block.settings.price }}</span><span class="per">{{ block.settings.price_note }}</span></p>
          <p class="plan-desc">{{ block.settings.description }}</p>
          {%- if block.settings.features != blank -%}
            <ul class="plan-list">
              {%- assign feats = block.settings.features | newline_to_br | split: '<br />' -%}
              {%- for feat in feats -%}
                {%- assign f = feat | strip -%}
                {%- if f != blank -%}<li>✔ {{ f }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <a href="{{ block.settings.button_link | default: '#contact' }}" class="btn {% if block.settings.featured %}btn-primary{% else %}btn-outline{% endif %} full">{{ block.settings.button_label }}</a>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="note center">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Plans & subscriptions",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Surprise Box of the Month" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A mystery gadget worth more than you pay" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Each month we pick a 3D-printed gadget and ship it to your door — its retail value always beats your subscription price. Shop one-off, or subscribe for the surprise." },
    { "type": "richtext", "id": "note", "label": "Footnote", "default": "<p>Every Surprise Box is guaranteed to contain a gadget worth more than the price you pay. Skip or cancel anytime.</p>" }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "checkbox", "id": "featured", "label": "Highlight this plan", "default": false },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "title", "label": "Title", "default": "Starter" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "One-time" },
        { "type": "text", "id": "price", "label": "Price", "default": "From $—" },
        { "type": "text", "id": "price_note", "label": "Price note", "default": "/ get a quote" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A single treasure box, filled and ready." },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "1 custom treasure box\nFirst fill of prizes included\nReorder refills anytime" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Plans & subscriptions",
      "blocks": [
        { "type": "plan", "settings": { "title": "Shop à la carte", "tag": "One-time", "price": "Pay per item", "price_note": "", "description": "Buy any gadget on its own — no subscription, no commitment.", "features": "Browse the full catalog\nMade to order in your color\nCustom requests welcome", "button_label": "Shop gadgets" } },
        { "type": "plan", "settings": { "featured": true, "badge": "Best Value", "title": "Surprise Box — Monthly", "tag": "Subscription", "price": "Monthly", "price_note": "billed each month", "description": "One mystery 3D-printed gadget every month, always worth more than you pay.", "features": "A surprise gadget every month\nGuaranteed value over your price\nNew themes & subscriber-only prints\nSkip or cancel anytime", "button_label": "Start the Surprise Box" } },
        { "type": "plan", "settings": { "title": "Surprise Box — Prepaid", "tag": "3 or 12 months", "price": "Save more", "price_note": "prepay & save", "description": "Prepay a few months at a lower price per box — and it makes a great gift.", "features": "Everything in Monthly\nLower price per box\nPrepay 3 or 12 months\nPerfect as a gift", "button_label": "Gift a subscription" } }
      ]
    }
  ]
}
{% endschema %}
