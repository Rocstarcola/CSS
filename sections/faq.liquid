<section id="faq" class="section">
  <div class="container narrow">
    <div class="section-head">
      <p class="eyebrow center">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div>{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false },
        { "type": "text", "id": "question", "label": "Question", "default": "What's in the Surprise Box of the Month?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>A different 3D-printed gadget each month, hand-picked by us — always worth more than your subscription price.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "What's in the Surprise Box of the Month?", "answer": "<p>A different 3D-printed gadget each month, hand-picked by us. We keep the exact item a surprise — but its retail value is always more than your subscription price.</p>" } },
        { "type": "qa", "settings": { "question": "How does the subscription work?", "answer": "<p>Subscribe monthly (or prepay 3 or 12 months to save). A new mystery gadget ships to you each month. You can skip a month or cancel anytime — no contracts.</p>" } },
        { "type": "qa", "settings": { "question": "Do you really sell treasure boxes?", "answer": "<p>We do! Our 3D-printed treasure boxes are one of our most popular products — find them in the shop alongside desk toys, tools, gifts and more.</p>" } },
        { "type": "qa", "settings": { "question": "What are your gadgets made of?", "answer": "<p>Durable, plant-based PLA plastic, 3D-printed in-house. Sturdy, lightweight, and available in a range of colors.</p>" } },
        { "type": "qa", "settings": { "question": "Can I request a custom design?", "answer": "<p>Yes! Have an idea or a design you want printed? Send us the details through the contact form and we'll see what we can make.</p>" } },
        { "type": "qa", "settings": { "question": "How long does shipping take?", "answer": "<p>Because gadgets are printed to order, most ship within a few business days. Free shipping on orders over $50.</p>" } }
      ]
    }
  ]
}
{% endschema %}
