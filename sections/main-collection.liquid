<section class="section">
  <div class="container">
    <div class="page-header">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte" style="max-width:60ch; margin:1rem auto 0;">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_sorting -%}
      <form method="get" style="display:flex; justify-content:flex-end; margin-bottom:1.5rem;">
        <label style="display:flex; gap:.5rem; align-items:center; font-weight:700;">
          {{ 'products.facets.sort_by_label' | t }}
          <select name="sort_by" onchange="this.form.submit()">
            {%- assign sorts = "manual,best-selling,title-ascending,price-ascending,price-descending,created-descending" | split: ',' -%}
            {%- for opt in sorts -%}
              <option value="{{ opt }}" {% if collection.sort_by == opt %}selected{% endif %}>{{ opt | replace: '-', ' ' | capitalize }}</option>
            {%- endfor -%}
          </select>
        </label>
      </form>
    {%- endif -%}

    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection-grid {% if section.settings.per_row == 4 %}cols-4{% endif %}">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">←</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">→</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="center" style="color: var(--ink-soft); padding: 3rem 0;">No products here yet — check back soon! 🧰</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 12 },
    { "type": "select", "id": "per_row", "label": "Products per row", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "checkbox", "id": "show_sorting", "label": "Show sort dropdown", "default": true }
  ]
}
{% endschema %}
