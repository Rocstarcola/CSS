<section class="strip">
  <div class="container strip-inner">
    {%- for block in section.blocks -%}
      <div class="strip-item" {{ block.shopify_attributes }}>
        <span class="strip-num">{{ block.settings.title }}</span>
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "100%" },
        { "type": "text", "id": "text", "label": "Text", "default": "3D-printed in-house" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "title": "100%", "text": "3D-printed in-house" } },
        { "type": "item", "settings": { "title": "Surprise Box", "text": "New mystery gadget monthly" } },
        { "type": "item", "settings": { "title": "Custom", "text": "Bring us your idea" } },
        { "type": "item", "settings": { "title": "Made to order", "text": "Fresh prints, fast shipping" } }
      ]
    }
  ]
}
{% endschema %}
