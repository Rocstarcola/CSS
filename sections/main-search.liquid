<section class="section">
  <div class="container">
    <div class="page-header"><h1>{{ 'general.search.search' | t }}</h1></div>

    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:520px; margin:0 auto 2.5rem; display:flex; gap:.5rem;">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
      <button type="submit" class="btn btn-primary">{{ 'general.search.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <p class="center" style="color:var(--ink-soft); margin-bottom:1.5rem;">{{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}</p>
        <div class="collection-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <div class="product-card"><div class="product-card__body">
                <h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                <p style="color:var(--ink-soft);">{{ item.content | strip_html | truncatewords: 24 }}</p>
              </div></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="center" style="color:var(--ink-soft);">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
