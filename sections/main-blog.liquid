<section class="section">
  <div class="container">
    <div class="page-header"><h1>{{ blog.title }}</h1></div>
    <div class="collection-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="product-card" style="text-decoration:none;">
          <span class="product-card__media">
            {%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: widths: '300,600', alt: article.title }}{%- else -%}<span class="product-card__placeholder">📦</span>{%- endif -%}
          </span>
          <div class="product-card__body">
            <h3 class="product-card__title">{{ article.title }}</h3>
            <span style="color:var(--ink-soft); font-size:.85rem;">{{ article.published_at | date: '%b %d, %Y' }}</span>
            <p style="color:var(--ink-soft);">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": []
}
{% endschema %}
