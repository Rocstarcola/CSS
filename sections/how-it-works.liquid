<section id="how" class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow center">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <article class="step" {{ block.shopify_attributes }}>
          <div class="step-num">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "From browse to doorstep in four simple steps." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pick your box" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Choose a design and size, then add your logo or colors for a custom look." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Browse the shop", "text": "Explore our 3D-printed gadgets — treasure boxes, desk toys, tools, gifts and more." } },
        { "type": "step", "settings": { "title": "We print to order", "text": "Each gadget is freshly 3D-printed in-house in your chosen color." } },
        { "type": "step", "settings": { "title": "Shipped to your door", "text": "We pack it up and send it out fast, with free shipping over $50." } },
        { "type": "step", "settings": { "title": "Or subscribe", "text": "Join the Surprise Box of the Month and get a mystery gadget worth more than you pay." } }
      ]
    }
  ]
}
{% endschema %}
