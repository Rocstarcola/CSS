<section id="how" class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow center">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <article class="step" {{ block.shopify_attributes }}>
          <div class="step-num">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "From first chat to happy kids in four simple steps." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pick your box" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Choose a design and size, then add your logo or colors for a custom look." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick your box", "text": "Choose a design and size, then add your logo or colors for a custom look." } },
        { "type": "step", "settings": { "title": "We print & fill", "text": "Your treasure box is 3D-printed and loaded with a curated mix of toy prizes." } },
        { "type": "step", "settings": { "title": "Delight your guests", "text": "Set it on the counter and let kids pick a prize. Parents love it, kids remember it." } },
        { "type": "step", "settings": { "title": "Auto-refill", "text": "Subscribe and fresh prize refills arrive on your schedule. Never run empty." } }
      ]
    }
  ]
}
{% endschema %}
