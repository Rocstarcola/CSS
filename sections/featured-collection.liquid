<section id="featured" class="section section-alt">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow center">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign products = collection.products -%}
    {%- if products.size > 0 -%}
      <div class="collection-grid {% if section.settings.per_row == '4' %}cols-4{% endif %}">
        {%- for product in products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- elsif section.settings.show_placeholders -%}
      {%- comment -%} Friendly placeholders shown only until products are added {%- endcomment -%}
      <div class="collection-grid {% if section.settings.per_row == '4' %}cols-4{% endif %}">
        {%- assign placeholders = "Bike Moto Sign|Personalized 3D-printed sign for kids|🏁;Treasure Box|Our signature 3D-printed treasure chest|🧰;Desk Gadget|Fidgets, organizers and desk toys|🎲" | split: ';' -%}
        {%- for ph in placeholders -%}
          {%- assign parts = ph | split: '|' -%}
          <div class="product-card">
            <span class="product-card__media"><span class="product-card__placeholder">{{ parts[2] }}</span></span>
            <div class="product-card__body">
              <h3 class="product-card__title">{{ parts[0] }}</h3>
              <p style="color: var(--ink-soft); margin:0;">{{ parts[1] }}</p>
              <div class="product-card__price"><span>Add products in Shopify</span></div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and products.size > 0 -%}
      <div class="fc-actions">
        <a href="{% if collection %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="btn btn-primary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh off the printer" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Our most popular 3D-printed gadgets, ready to make to order." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 6 },
    { "type": "select", "id": "per_row", "label": "Products per row", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all gadgets" },
    { "type": "checkbox", "id": "show_placeholders", "label": "Show placeholder cards when empty", "info": "Turn off for 'related products' rows.", "default": true }
  ],
  "presets": [{ "name": "Featured collection", "settings": { "show_placeholders": true } }]
}
{% endschema %}
