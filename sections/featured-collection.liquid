<section id="boxes" class="section section-alt">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow center">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign products = collection.products -%}
    <div class="collection-grid {% if section.settings.per_row == 4 %}cols-4{% endif %}">
      {%- if products.size > 0 -%}
        {%- for product in products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder cards before products exist {%- endcomment -%}
        {%- assign placeholders = "The Classic Chest|Our signature pirate-style chest|🧰;The Castle Vault|Bigger and bolder for busy lobbies|🏰;The Mini Stash|Compact box for tight counters|🎒" | split: ';' -%}
        {%- for ph in placeholders -%}
          {%- assign parts = ph | split: '|' -%}
          <div class="product-card">
            <span class="product-card__media"><span class="product-card__placeholder">{{ parts[2] }}</span></span>
            <div class="product-card__body">
              <h3 class="product-card__title">{{ parts[0] }}</h3>
              <p style="color: var(--ink-soft); margin:0;">{{ parts[1] }}</p>
              <div class="product-card__price"><span>Add products in Shopify</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="fc-actions">
        <a href="{% if collection %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="btn btn-primary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Boxes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Treasure boxes for every counter" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Sturdy, reusable, and printed to last. Pick a style that fits your space." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 6 },
    { "type": "select", "id": "per_row", "label": "Products per row", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all boxes" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
